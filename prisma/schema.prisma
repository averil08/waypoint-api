generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ====== ENUMS =======
enum VehicleType {
    JEEPNEY
    MODERNJEEP
    TAXI
}

enum RouteStatus {
    ACTIVE
    INACTIVE
    UNKNOWN
}

enum StopType {
    TERMINAL
    INTERMEDIATE
}

// ====== MODELS ======
model Route {
    id          String      @id @default(uuid()) @map("id")
    routeNumber Int         @unique @map("route_number")
    routeName   String      @map("route_name")
    vehicleType VehicleType @map("vehicle_type")
    status      RouteStatus @default(ACTIVE) @map("route_status")
    createdAt   DateTime    @default(now()) @map("created_at")
    updatedAt   DateTime    @updatedAt @map("updated_at")

    routeStops RouteStop[]
}

//time schedule of each route need to add
model RouteStop {
    routeId  String   @map("route_id")
    stopId   String   @map("stop_id")
    sequence Int      @map("sequence")
    stopType StopType @map("stop_type")

    route Route @relation(fields: [routeId], references: [id]) //references to Route.id (PK)
    stop  Stop  @relation(fields: [stopId], references: [id]) //references to Stop.id (PK)
    //routeId + stopId = connects FK to PK's of Route.id, Stop.id models

    @@id([routeId, stopId]) //ensure route+stop cant exist twice
    @@index([routeId]) //speeds up "get all stops for a route"
    @@index([stopId]) //speeds "get all routes for a stop"
    @@map("route_stop") //RouteStop references to table name in db
}

model Stop {
    id         String      @id @default(uuid())
    name       String
    latitude   Decimal     @db.Decimal(10, 8)
    longitude  Decimal     @db.Decimal(11, 8)
    routeStops RouteStop[]
    createdAt  DateTime    @default(now())
    updatedAt  DateTime    @updatedAt
}
